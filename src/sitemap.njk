---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>{{ site.url }}/</loc>
    <xhtml:link rel="alternate" hreflang="ro" href="{{ site.url }}/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}/en/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/"/>
  </url>
  <url>
    <loc>{{ site.url }}/en/</loc>
    <xhtml:link rel="alternate" hreflang="ro" href="{{ site.url }}/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}/en/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/"/>
  </url>
  <url>
    <loc>{{ site.url }}/nis2/</loc>
    <xhtml:link rel="alternate" hreflang="ro" href="{{ site.url }}/nis2/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}/en/nis2/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/nis2/"/>
  </url>
  <url>
    <loc>{{ site.url }}/en/nis2/</loc>
    <xhtml:link rel="alternate" hreflang="ro" href="{{ site.url }}/nis2/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}/en/nis2/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/nis2/"/>
  </url>
  <url>
    <loc>{{ site.url }}/blog/</loc>
    <xhtml:link rel="alternate" hreflang="ro" href="{{ site.url }}/blog/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}/en/blog/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/blog/"/>
  </url>
  <url>
    <loc>{{ site.url }}/en/blog/</loc>
    <xhtml:link rel="alternate" hreflang="ro" href="{{ site.url }}/blog/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}/en/blog/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/blog/"/>
  </url>
  {% for post in collections.blogRo %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <xhtml:link rel="alternate" hreflang="ro" href="{{ site.url }}/blog/{{ post.fileSlug }}/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}/en/blog/{{ post.fileSlug }}/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/blog/{{ post.fileSlug }}/"/>
  </url>
  {% endfor %}
  {% for post in collections.blogEn %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <xhtml:link rel="alternate" hreflang="ro" href="{{ site.url }}/blog/{{ post.fileSlug }}/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}/en/blog/{{ post.fileSlug }}/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}/blog/{{ post.fileSlug }}/"/>
  </url>
  {% endfor %}
</urlset>
