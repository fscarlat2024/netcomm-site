{% set t = i18n[lang] %}
{% set c = site[lang] %}
{% set ck = site.cookies[lang] %}
{% set home = "/" if lang == "ro" else "/en/" %}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ c.metaTitle }}</title>
  <meta name="description" content="{{ c.metaDesc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="ro" href="{{ site.url }}/">
  <link rel="alternate" hreflang="en" href="{{ site.url }}/en/">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ c.metaTitle }}">
  <meta property="og:description" content="{{ c.metaDesc }}">
  <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="{{ 'ro_RO' if lang == 'ro' else 'en_US' }}">
  <meta name="theme-color" content="#0B1220">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ c.metaTitle }}">
  <meta name="twitter:description" content="{{ c.metaDesc }}">
  <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230B1220'/%3E%3Cpath d='M9 22V10l14 12V10' fill='none' stroke='%238FB8E6' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.brandName }}",
    "alternateName": "NCS",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/assets/img/brand/ncs-color.png",
    "email": "{{ site.email }}",
    "telephone": "{{ site.phoneRaw }}",
    "description": "{{ c.metaDesc }}",
    "address": { "@type": "PostalAddress", "streetAddress": "Str. Samuil Vulcan nr. 12", "addressLocality": "Bucuresti", "addressCountry": "RO" },
    "areaServed": "RO",
    "sameAs": ["{{ site.url }}"]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for f in site.faq %}{ "@type": "Question", "name": {{ f['q_' ~ lang] | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f['a_' ~ lang] | dump | safe }} } }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
</head>
<body>
  <a href="#main" class="skip-link">{{ t.skip }}</a>
  <header class="nav" id="nav">
    <div class="wrap nav-in">
      <a href="{{ home }}" class="brand" aria-label="NCS - Net Communications System">
        <img src="/assets/img/brand/ncs-color.png" alt="NCS - Net Communications System" class="brand-logo brand-logo-dark">
        <img src="/assets/img/brand/ncs-invert.png" alt="" aria-hidden="true" class="brand-logo brand-logo-light">
      </a>
      <nav class="nav-links" id="navlinks">
        <a href="{{ home }}#servicii">{{ t.nav_services }}</a>
        <a href="{{ home }}#securitate">{{ t.nav_security }}</a>
        <a href="{{ home }}#nis2" class="nav-nis2">NIS2</a>
        <a href="{{ home }}#de-ce" class="hide-md">{{ t.nav_why }}</a>
        <a href="{{ home }}#tehnologii" class="hide-md">{{ t.nav_tech }}</a>
        <a href="{{ home }}#abonamente">{{ t.nav_pricing }}</a>
        <span class="lang-switch">
          <a href="/"{% if lang == "ro" %} class="on"{% endif %}>RO</a>
          <a href="/en/"{% if lang == "en" %} class="on"{% endif %}>EN</a>
        </span>
        <a href="{{ home }}#contact" class="btn btn-primary nav-cta">{{ t.nav_cta }}</a>
      </nav>
      <button class="nav-toggle" id="navToggle" aria-label="Meniu" aria-expanded="false" type="button">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap foot-in">
      <div class="foot-brand">
        <img src="/assets/img/brand/ncs-invert.png" alt="NCS" class="foot-logo">
        <p>{{ c.metaDesc }}</p>
      </div>
      <div class="foot-col">
        <h4>{{ t.nav_services }}</h4>
        <a href="{{ home }}#servicii">{{ t.nav_services }}</a>
        <a href="{{ home }}#securitate">{{ t.nav_security }}</a>
        <a href="{{ home }}#abonamente">{{ t.nav_pricing }}</a>
      </div>
      <div class="foot-col">
        <h4>{{ t.nav_contact }}</h4>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        <a href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a>
        <span>{{ site.address }}</span>
      </div>
    </div>
    <div class="wrap foot-bottom">
      <span>&copy; {{ '2026' }} {{ site.brandName }}. {{ c.rights }}</span>
      <span class="foot-links"><a href="#" data-cookie-policy>{{ ck.policyTitle }}</a> &middot; netcomm.ro</span>
    </div>
  </footer>

  <div class="modal" id="consultModal" hidden role="dialog" aria-modal="true" aria-labelledby="cmTitle">
    <div class="modal-backdrop" data-close></div>
    <div class="modal-card" role="document">
      <button class="modal-x" type="button" data-close aria-label="{{ t.form_close }}">&times;</button>
      <div class="form-body">
        <h3 id="cmTitle">{{ t.form_title }}</h3>
        <p class="modal-sub">{{ t.form_sub }}</p>
        <form id="consultForm" novalidate data-email="{{ site.email }}" data-web3key="{{ site.web3formsKey }}" data-subject="{{ t.form_title }}" data-req="{{ t.form_req }}" data-err="{{ t.form_error }}">
          <input type="hidden" name="access_key" value="{{ site.web3formsKey }}">
          <input type="hidden" name="subject" value="{{ t.form_title }} - netcomm.ro">
          <input type="hidden" name="from_name" value="netcomm.ro">
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <div class="fgrid">
            <label class="field"><span>{{ t.form_name }} *</span><input type="text" name="name" required autocomplete="name"></label>
            <label class="field"><span>{{ t.form_company }}</span><input type="text" name="company" autocomplete="organization"></label>
            <label class="field"><span>{{ t.form_email }} *</span><input type="email" name="email" required autocomplete="email"></label>
            <label class="field"><span>{{ t.form_phone }}</span><input type="tel" name="phone" autocomplete="tel"></label>
          </div>
          <label class="field"><span>{{ t.form_interest }}</span>
            <select name="interest">
              {% for o in t.form_opts %}<option>{{ o }}</option>{% endfor %}
            </select>
          </label>
          <label class="field"><span>{{ t.form_msg }}</span><textarea name="message" rows="3"></textarea></label>
          <button type="submit" class="btn btn-primary btn-block modal-send">{{ t.form_send }}</button>
          <p class="modal-err" id="formErr" hidden></p>
          <p class="modal-note">{{ t.form_note }}</p>
        </form>
      </div>
      <div class="form-success" hidden>
        <div class="fs-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4 4L19 6"/></svg></div>
        <h3>{{ t.form_success_title }}</h3>
        <p>{{ t.form_success_msg }}</p>
        <button type="button" class="btn btn-primary" data-close>{{ t.form_close }}</button>
      </div>
    </div>
  </div>

  <div class="cookie-banner" id="cookieBanner" data-ga="{{ site.gaId }}" hidden>
    <div class="cookie-in">
      <p class="cookie-txt">{{ ck.banner }} <a href="#" data-cookie-policy>{{ ck.more }}</a></p>
      <div class="cookie-actions">
        <button type="button" class="btn btn-reject" data-reject>{{ ck.reject }}</button>
        <button type="button" class="btn btn-primary" data-accept>{{ ck.accept }}</button>
      </div>
    </div>
  </div>

  <div class="modal" id="cookieModal" hidden role="dialog" aria-modal="true" aria-labelledby="ckTitle">
    <div class="modal-backdrop" data-close></div>
    <div class="modal-card" role="document">
      <button class="modal-x" type="button" data-close aria-label="{{ ck.accept }}">&times;</button>
      <h3 id="ckTitle">{{ ck.policyTitle }}</h3>
      <p class="modal-sub">{{ ck.policyIntro }}</p>
      <div class="cookie-policy">
        {% for s in ck.sections %}
        <div class="cp-sec"><b>{{ s.h }}</b><p>{{ s.p }}</p></div>
        {% endfor %}
        <p class="cp-change">{{ ck.policyChange }}</p>
        <div class="cp-actions">
          <button type="button" class="btn btn-outline" data-reject>{{ ck.reject }}</button>
          <button type="button" class="btn btn-primary" data-accept>{{ ck.accept }}</button>
        </div>
        <p class="modal-note">{{ ck.contact }}</p>
      </div>
    </div>
  </div>

  <script src="/assets/js/main.js?v={{ build }}" defer></script>
  <script src="/assets/js/nis2.js?v={{ build }}" defer></script>
  <script src="/assets/js/cookies.js?v={{ build }}" defer></script>
</body>
</html>
