---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ '/index.html' if lang == 'ro' else '/en/index.html' }}"
layout: base.njk
---
{% from "icons.njk" import icon %}
{% set c = site[lang] %}
{% set home = "/" if lang == "ro" else "/en/" %}

<section class="hero" id="top">
  <div class="hero-bg" style="background-image:url('{{ site.heroImage }}')"></div>
  <div class="hero-veil"></div>
  <div class="wrap hero-in reveal">
    <span class="badge">{{ icon("spark") }} {{ c.badge }}</span>
    <h1>{{ c.heroTitle }}</h1>
    <p class="lead">{{ c.heroLead }}</p>
    <div class="hero-cta">
      <a href="{{ home }}#contact" class="btn btn-primary btn-lg">{{ c.heroCta }} {{ icon("arrow") }}</a>
      <a href="{{ home }}#servicii" class="btn btn-ghost btn-lg">{{ c.heroCta2 }}</a>
    </div>
    <p class="hero-trust">{{ icon("check") }} {{ c.heroTrust }}</p>
  </div>
  <div class="wrap">
    <div class="stat-strip reveal">
      {% for s in site.stats %}
      <div class="stat"><b>{{ s.num }}</b><span>{{ s[lang] }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="clients-band" id="clienti">
  <div class="wrap">
    <p class="clients-eyebrow reveal">{{ c.clientsEyebrow }}</p>
  </div>
  <div class="logo-marquee reveal">
    <div class="logo-track">
      {% for cl in site.clients %}<span class="logo-item"><img src="{{ cl.img }}" alt="{{ cl.alt }}" loading="lazy" decoding="async"></span>{% endfor %}
      {% for cl in site.clients %}<span class="logo-item" aria-hidden="true"><img src="{{ cl.img }}" alt="" loading="lazy" decoding="async"></span>{% endfor %}
    </div>
  </div>
</section>

<section class="section band-soft" id="despre">
  <div class="wrap about">
    <div class="about-text reveal">
      <span class="eyebrow">{{ c.aboutEyebrow }}</span>
      <h2>{{ c.aboutTitle }}</h2>
      <p>{{ c.aboutP1 }}</p>
      <p>{{ c.aboutP2 }}</p>
    </div>
    <div class="about-points reveal">
      <ul class="pointlist">
        {% for p in c.aboutPoints %}
        <li>{{ icon("check") }} <span>{{ p }}</span></li>
        {% endfor %}
      </ul>
      <div class="about-mini">
        {% for h in site.highlights %}
        <div class="am"><b>{{ h.num }}</b><span>{{ h[lang] }}</span></div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="section" id="servicii">
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">{{ c.servicesEyebrow }}</span>
      <h2>{{ c.servicesTitle }}</h2>
      <p class="sub">{{ c.servicesLead }}</p>
    </div>
    <div class="grid-3">
      {% for s in site.services %}
      <article class="card reveal">
        <div class="card-ic">{{ icon(s.icon) }}</div>
        <h3>{{ s[lang].title }}</h3>
        <p>{{ s[lang].desc }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section band-dark" id="securitate">
  <div class="wrap split">
    <div class="split-media reveal">
      <img src="/assets/img/photos/cyber.jpg" alt="Cybersecurity - protectia datelor" loading="lazy" decoding="async">
      <div class="split-media badge-float">{{ icon("shield") }} NIS2 &middot; GDPR</div>
    </div>
    <div class="split-text reveal">
      <span class="eyebrow eyebrow-on-dark">{{ c.cyberEyebrow }}</span>
      <h2>{{ c.cyberTitle }}</h2>
      <p class="sub">{{ c.cyberLead }}</p>
      <ul class="cyberlist">
        {% for p in c.cyberPoints %}
        <li>
          <span class="cl-ic">{{ icon("check") }}</span>
          <span><b>{{ p.title }}</b>{{ p.desc }}</span>
        </li>
        {% endfor %}
      </ul>
      <a href="{{ home }}#contact" class="btn btn-cyan">{{ c.heroCta }} {{ icon("arrow") }}</a>
    </div>
  </div>
</section>

{% set n = site.nis2[lang] %}
{% set nis2cfg = { email: site.email, subject: n.emailSubject, body: n.emailBody, gapsTitle: n.gapsTitle, levels: n.levels, interest: i18n[lang].form_opts[2], tHigh: 80, tMid: 50 } %}
<section class="section band-dark nis2" id="nis2">
  <div class="wrap nis2-grid">
    <div class="nis2-intro reveal">
      <span class="eyebrow eyebrow-on-dark">{{ n.eyebrow }}</span>
      <h2>{{ n.title }}</h2>
      <p class="sub">{{ n.lead }}</p>
      <div class="guarantee">
        <div class="guarantee-head"><span class="g-ic">{{ icon("shield") }}</span><b>{{ n.guaranteeTitle }}</b></div>
        <p>{{ n.guaranteeText }}</p>
        <ul>
          {% for gp in n.guaranteePoints %}<li>{{ icon("check") }} {{ gp }}</li>{% endfor %}
        </ul>
      </div>
    </div>

    <div class="nis2-card reveal" id="nis2Checker" data-cfg="{{ nis2cfg | dump | urlencode }}">
      <div class="nis2-quiz">
        <p class="nis2-hint">{{ n.checkIntro }}</p>
        {% for q in site.nis2.questions %}
        <div class="q" data-idx="{{ loop.index0 }}" data-gap="{{ q['gap_' ~ lang] }}">
          <span class="q-txt">{{ q['q_' ~ lang] }}</span>
          <div class="q-opts" role="group">
            {% for opt in n.opts %}
            <button type="button" class="q-opt" data-v="{{ 2 - loop.index0 }}">{{ opt }}</button>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
        <button type="button" class="btn btn-cyan btn-block nis2-calc" id="nis2Calc">{{ n.calcBtn }} {{ icon("arrow") }}</button>
      </div>

      <div class="nis2-result" id="nis2Result" hidden>
        <span class="nis2-rtitle">{{ n.resultTitle }}</span>
        <div class="nis2-gauge">
          <div class="nis2-score" id="nis2Score">0%</div>
          <div class="nis2-bar"><span id="nis2Fill"></span></div>
        </div>
        <div class="nis2-level"><b id="nis2LevelTitle"></b><p id="nis2LevelMsg"></p></div>
        <div class="nis2-gaps" id="nis2Gaps" hidden>
          <b id="nis2GapsTitle"></b>
          <ul id="nis2GapsList"></ul>
        </div>
        <div class="nis2-cta">
          <a class="btn btn-primary btn-block" id="nis2Cta" href="#contact">{{ n.cta }} {{ icon("arrow") }}</a>
          <a class="btn btn-ghost btn-block" href="{{ home }}#contact">{{ n.ctaAlt }}</a>
        </div>
        <button type="button" class="nis2-redo" id="nis2Redo">&larr; {{ n.calcBtn }}</button>
      </div>
    </div>
  </div>
</section>

<section class="section" id="proces">
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">{{ c.processEyebrow }}</span>
      <h2>{{ c.processTitle }}</h2>
      <p class="sub">{{ c.processLead }}</p>
    </div>
    <div class="grid-4 steps">
      {% for st in site.process %}
      <article class="step reveal">
        <div class="step-top"><span class="step-num">{{ st.num }}</span><span class="step-ic">{{ icon(st.icon) }}</span></div>
        <h3>{{ st[lang].title }}</h3>
        <p>{{ st[lang].desc }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section band-soft" id="de-ce">
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">{{ c.whyEyebrow }}</span>
      <h2>{{ c.whyTitle }}</h2>
      <p class="sub">{{ c.whyLead }}</p>
    </div>
    <div class="grid-4">
      {% for w in site.why %}
      <article class="why reveal">
        <div class="why-ic">{{ icon(w.icon) }}</div>
        <h3>{{ w[lang].title }}</h3>
        <p>{{ w[lang].desc }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="tehnologii">
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">{{ c.techEyebrow }}</span>
      <h2>{{ c.techTitle }}</h2>
      <p class="sub">{{ c.techLead }}</p>
    </div>
  </div>
  <div class="marquee reveal">
    <div class="marquee-track">
      {% for tItem in site.tech %}<span class="chip">{{ tItem }}</span>{% endfor %}
      {% for tItem in site.tech %}<span class="chip" aria-hidden="true">{{ tItem }}</span>{% endfor %}
    </div>
  </div>
</section>

<section class="section band-soft" id="abonamente">
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">{{ c.pricingEyebrow }}</span>
      <h2>{{ c.pricingTitle }}</h2>
      <p class="sub">{{ c.pricingLead }}</p>
    </div>
    <div class="grid-3 plans">
      {% for pl in site.pricing %}
      <article class="plan reveal{% if pl.popular %} plan-pop{% endif %}">
        {% if pl.popular %}<span class="plan-tag">{{ "CEL MAI ALES" if lang == "ro" else "MOST CHOSEN" }}</span>{% endif %}
        <h3>{{ pl.name }}</h3>
        <p class="plan-tagline">{{ pl[lang].tagline }}</p>
        <ul>
          {% for f in pl[lang].features %}
          <li>{{ icon("check") }} {{ f }}</li>
          {% endfor %}
        </ul>
        <a href="{{ home }}#contact" class="btn {% if pl.popular %}btn-primary{% else %}btn-outline{% endif %} btn-block">{{ c.pricingCta }}</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="intrebari">
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">{{ c.faqEyebrow }}</span>
      <h2>{{ c.faqTitle }}</h2>
      <p class="sub">{{ c.faqLead }}</p>
    </div>
    <div class="faq reveal">
      {% for f in site.faq %}
      <details class="faq-item"{% if loop.first %} open{% endif %}>
        <summary>{{ f['q_' ~ lang] }}<span class="faq-plus">{{ icon("arrow") }}</span></summary>
        <div class="faq-a"><p>{{ f['a_' ~ lang] }}</p></div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section band-dark contact" id="contact">
  <div class="contact-bg" style="background-image:url('/assets/img/photos/datacenter.jpg')"></div>
  <div class="contact-veil"></div>
  <div class="wrap contact-in reveal">
    <span class="eyebrow eyebrow-on-dark">{{ c.contactEyebrow }}</span>
    <h2>{{ c.contactTitle }}</h2>
    <p class="sub">{{ c.contactLead }}</p>
    <div class="contact-cards">
      <a class="ccard" href="mailto:{{ site.email }}">
        <div class="ccard-ic">{{ icon("mail") }}</div>
        <b>{{ c.contactEmail }}</b><span>{{ site.email }}</span>
      </a>
      <a class="ccard" href="tel:{{ site.phoneRaw }}">
        <div class="ccard-ic">{{ icon("phone") }}</div>
        <b>{{ c.contactPhone }}</b><span>{{ site.phone }}</span>
      </a>
      <div class="ccard ccard-static">
        <div class="ccard-ic">{{ icon("pin") }}</div>
        <b>Bucuresti</b><span>{{ site.address }}</span>
      </div>
    </div>
  </div>
</section>
